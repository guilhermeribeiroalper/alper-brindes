# Banco de dados. Em desenvolvimento, SQLite (caminho relativo à raiz do projeto).
# Em produção (PostgreSQL): postgresql://usuario:senha@host:5432/brindes
DATABASE_URL="file:./prisma/dev.db"

# Admin inicial criado pelo seed (npm run db:seed). Use uma senha forte.
SEED_ADMIN_EMAIL="admin@alper.com.br"
SEED_ADMIN_SENHA=""
SEED_ADMIN_NOME="Administrador"

# Solicitante de exemplo criado pelo seed (opcional; se vazio, não é criado).
SEED_SOLICITANTE_EMAIL="solicitante@alper.com.br"
SEED_SOLICITANTE_SENHA=""
