# Banco de dados: "file:..." usa SQLite (desenvolvimento); "postgresql://..." usa PostgreSQL (produção).
DATABASE_URL="file:./prisma/dev.db"

# Admin inicial criado pelo seed (npm run db:seed). Use uma senha forte.
SEED_ADMIN_EMAIL="admin@alper.com.br"
SEED_ADMIN_SENHA=""
SEED_ADMIN_NOME="Administrador"

# "false" impede o seed de criar o catálogo de exemplo (útil em produção).
SEED_PRODUTOS_EXEMPLO=""

# Solicitante de exemplo criado pelo seed (opcional; se vazio, não é criado).
SEED_SOLICITANTE_EMAIL="solicitante@alper.com.br"
SEED_SOLICITANTE_SENHA=""

# Integração com o ClickUp: cria uma tarefa quando o admin aprova uma solicitação.
# Token pessoal (Settings → Apps → API Token, começa com "pk_") e o ID da lista de destino.
# Se ficarem vazios, a aprovação funciona e a tarefa pode ser criada depois pela tela.
CLICKUP_API_TOKEN=""
CLICKUP_LIST_ID=""
# Opcional: só para testes com um servidor que imita a API.
# CLICKUP_API_URL="https://api.clickup.com/api/v2"
